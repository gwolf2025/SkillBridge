# SkillBridge Environment Configuration
#
# Copy this file to .env.local and fill in values as needed.
# None of these variables are required for bootstrap, parsing,
# conversion, compilation, validation, or default tests.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
SKILLBRIDGE_REGISTRY_URL=
SKILLBRIDGE_TELEMETRY_ENABLED=false
SKILLBRIDGE_LOG_LEVEL=info
