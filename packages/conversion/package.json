{
  "name": "@skillbridge/conversion",
  "version": "0.1.0-alpha",
  "private": false,
  "description": "Orchestration of the complete conversion pipeline through SkillBridge IR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillbridge/skillbridge.git"
  },
  "homepage": "https://github.com/skillbridge/skillbridge",
  "bugs": {
    "url": "https://github.com/skillbridge/skillbridge/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepack": "node -e \"const f=require(\\\"fs\\\");const p=require(\\\"path\\\");function w(d){try{f.readdirSync(d).forEach(e=\u003e{const s=p.join(d,e);if(f.statSync(s).isDirectory())w(s);else if(e.includes(\\\".test.\\\"))f.rmSync(s)})}catch(e){}}w(\\\"dist\\\")\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@skillbridge/adapter-sdk": "workspace:*",
    "@skillbridge/compatibility": "workspace:*",
    "@skillbridge/ir": "workspace:*",
    "@skillbridge/parser": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
