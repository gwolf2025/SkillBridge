{
  "name": "@skillbridge/installer",
  "version": "0.1.0-alpha",
  "private": false,
  "description": "Cross-adapter installation planning — scope resolution, conflict detection, integrity manifests, dry-run output",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillbridge/skillbridge.git"
  },
  "homepage": "https://github.com/skillbridge/skillbridge",
  "bugs": {
    "url": "https://github.com/skillbridge/skillbridge/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {
    "@skillbridge/adapter-sdk": "workspace:*",
    "@skillbridge/core": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
