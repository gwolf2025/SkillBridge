{
  "name": "@skillbridge/playground",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,ui \"pnpm dev:api\" \"pnpm dev:ui\"",
    "dev:api": "tsx watch api/server.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "playwright install chromium 2>/dev/null || true"
  },
  "dependencies": {
    "@skillbridge/adapter-portable": "workspace:*",
    "@skillbridge/adapter-claude": "workspace:*",
    "@skillbridge/adapter-codex": "workspace:*",
    "@skillbridge/adapter-opencode": "workspace:*",
    "@skillbridge/conversion": "workspace:*",
    "@skillbridge/registry-local": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
