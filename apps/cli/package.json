{
  "name": "@skillbridge/cli",
  "version": "0.1.0-alpha",
  "private": false,
  "description": "SkillBridge command-line application — convert AI-agent skills across vendor formats",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "skillbridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepack": "node -e \"const f=require(\\\"fs\\\");const p=require(\\\"path\\\");function w(d){try{f.readdirSync(d).forEach(e=\u003e{const s=p.join(d,e);if(f.statSync(s).isDirectory())w(s);else if(e.includes(\\\".test.\\\"))f.rmSync(s)})}catch(e){}}w(\\\"dist\\\")\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillbridge/skillbridge.git"
  },
  "homepage": "https://github.com/skillbridge/skillbridge",
  "bugs": {
    "url": "https://github.com/skillbridge/skillbridge/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@skillbridge/adapter-claude": "workspace:*",
    "@skillbridge/adapter-codex": "workspace:*",
    "@skillbridge/adapter-opencode": "workspace:*",
    "@skillbridge/adapter-portable": "workspace:*",
    "@skillbridge/adapter-sdk": "workspace:*",
    "@skillbridge/compiler": "workspace:*",
    "@skillbridge/conversion": "workspace:*",
    "@skillbridge/core": "workspace:*",
    "@skillbridge/installer": "workspace:*",
    "@skillbridge/ir": "workspace:*",
    "@skillbridge/parser": "workspace:*",
    "@skillbridge/registry-local": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
