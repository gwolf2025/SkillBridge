{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git push": "deny",
      "git push *": "deny",
      "git commit": "deny",
      "git commit *": "deny",
      "git tag": "deny",
      "git tag *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "git fetch": "allow",
      "git log": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "node *": "allow",
      "npx *": "allow"
    }
  }
}
