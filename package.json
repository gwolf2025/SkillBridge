{
  "name": "skillbridge",
  "version": "0.0.0",
  "private": true,
  "description": "Write an AI skill once. Run it anywhere.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:roundtrip": "vitest run --project roundtrip",
    "test:conversion": "vitest run --project conversion",
    "depcheck": "depcruise --validate .dependency-cruiser.js packages/ adapters/ apps/ commercial/",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "verify": "pnpm format:check && pnpm lint && pnpm depcheck && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:roundtrip && pnpm test:conversion && pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
